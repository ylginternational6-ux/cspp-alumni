# Copiez ce fichier en ".env" à la racine du projet.
#
# L'application démarre et fonctionne SANS aucune de ces variables (mode
# démo : pages en données mockées, mais pas de connexion ni de persistance).
# Configurez DATABASE_URL pour activer la connexion, les profils, la
# vérification des comptes, etc.

# --- Base de données (MySQL / MariaDB via Drizzle) ---
# Voir docker-compose.yml pour lancer une base locale en une commande :
#   docker compose up -d
DATABASE_URL=mysql://cspp:cspp_password@localhost:3306/cspp_alumni

# --- Sessions ---
# Secret de signature des jetons de session (JWT). Changez cette valeur,
# surtout avant tout déploiement.
JWT_SECRET=change-me-in-production

# openId à qui attribuer automatiquement le rôle admin à sa première
# connexion locale (ex: "local:admin@example.com").
OWNER_OPEN_ID=

# --- Serveur ---
PORT=3000

# --- Stockage de fichiers (optionnel) ---
# Si non renseigné, les fichiers sont stockés sur le disque local dans
# ./uploads et servis sous /uploads/*. Renseignez ces variables pour
# basculer sur Amazon S3 (ou un service compatible S3).
S3_BUCKET=
S3_REGION=eu-west-3
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Carte (optionnel) ---
# Nécessaire uniquement si vous utilisez le composant MapView
# (client/src/components/Map.tsx), non utilisé par défaut dans l'app.
VITE_GOOGLE_MAPS_API_KEY=
